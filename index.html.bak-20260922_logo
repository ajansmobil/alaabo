<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Alabo Company</title>
  <meta name="description" content="Alabo Şirketi - 1952'den beri ayakkabı imalatı ve ticaretinde öncü firma. Poliüretan, PFC ve EVA alanlarında uzmanlaşmış üretim tesisleri." />
  <link rel="canonical" href="https://alaabo.company/" />
  <link rel="alternate" hreflang="tr" href="https://alaabo.company/tr/" />
  <link rel="alternate" hreflang="en" href="https://alaabo.company/en/" />
  <link rel="alternate" hreflang="ar" href="https://alaabo.company/ar/" />
  <link rel="alternate" hreflang="fr" href="https://alaabo.company/fr/" />
  <link rel="alternate" hreflang="x-default" href="https://alaabo.company/tr/" />
  <script>
(function() {
  var available = ["tr","en","ar","fr"];
  var fallbackLang = "en";
  var defaultLang = "tr";
  var settingDefaultLang = "";
  if (settingDefaultLang && available.indexOf(settingDefaultLang) !== -1) {
    location.replace('/' + settingDefaultLang + '/' + (location.search || '') + (location.hash || ''));
    return;
  }
  var browserLangs = [];
  if (navigator.languages && navigator.languages.length) {
    navigator.languages.forEach(function(l) {
      var code = (l.split('-')[0] || '').toLowerCase();
      if (code && browserLangs.indexOf(code) === -1) browserLangs.push(code);
    });
  }
  if (!browserLangs.length && navigator.language) {
    browserLangs.push((navigator.language.split('-')[0] || defaultLang).toLowerCase());
  }
  var chosen = null;
  for (var i = 0; i < browserLangs.length; i++) {
    if (available.indexOf(browserLangs[i]) !== -1) {
      chosen = browserLangs[i];
      break;
    }
  }
  if (chosen === null) {
    chosen = fallbackLang;
  }
  var target = '/' + chosen + '/' + (location.search || '') + (location.hash || '');
  location.replace(target);
})();
  </script>
</head>
<body>
  <p>Alabo Company</p>
  <noscript><p>Dil seçin: <a href="/tr/">TR</a> | <a href="/en/">EN</a> | <a href="/ar/">AR</a> | <a href="/fr/">FR</a></p></noscript>
</body>
</html>